<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vaultbar.App"
             Name="Vaultbar"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BqSurface" Color="#FFFFFF" />
          <SolidColorBrush x:Key="BqFooter" Color="#F5F7FA" />
          <SolidColorBrush x:Key="BqBorder" Color="#DFE4EA" />
          <SolidColorBrush x:Key="BqText" Color="#1A1F27" />
          <SolidColorBrush x:Key="BqMuted" Color="#667285" />
          <SolidColorBrush x:Key="BqAccent" Color="#175DDC" />
          <SolidColorBrush x:Key="BqSelected" Color="#E7EEFC" />
          <SolidColorBrush x:Key="BqHover" Color="#F2F5F9" />
          <SolidColorBrush x:Key="BqKbd" Color="#E7EBF0" />
          <SolidColorBrush x:Key="BqTile" Color="#EDF0F4" />
          <SolidColorBrush x:Key="BqError" Color="#C3361F" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BqSurface" Color="#1F242C" />
          <SolidColorBrush x:Key="BqFooter" Color="#191D24" />
          <SolidColorBrush x:Key="BqBorder" Color="#353C47" />
          <SolidColorBrush x:Key="BqText" Color="#E8ECF1" />
          <SolidColorBrush x:Key="BqMuted" Color="#8F9AAB" />
          <SolidColorBrush x:Key="BqAccent" Color="#7DA4F6" />
          <SolidColorBrush x:Key="BqSelected" Color="#283958" />
          <SolidColorBrush x:Key="BqHover" Color="#272D36" />
          <SolidColorBrush x:Key="BqKbd" Color="#313843" />
          <SolidColorBrush x:Key="BqTile" Color="#2C323C" />
          <SolidColorBrush x:Key="BqError" Color="#F2806F" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <StreamGeometry x:Key="IconSearch">M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</StreamGeometry>
      <StreamGeometry x:Key="IconLock">M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z</StreamGeometry>
      <StreamGeometry x:Key="IconStar">M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z</StreamGeometry>
      <StreamGeometry x:Key="IconCard">M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z</StreamGeometry>
      <StreamGeometry x:Key="IconNote">M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z</StreamGeometry>
      <StreamGeometry x:Key="IconPerson">M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z</StreamGeometry>
      <StreamGeometry x:Key="IconKey">M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z</StreamGeometry>
      <StreamGeometry x:Key="IconTimer">M15 1H9v2h6V1zm-4 13h2V8h-2v6zm8.03-6.61l1.42-1.42c-.43-.51-.9-.99-1.41-1.41l-1.42 1.42C16.07 4.74 14.12 4 12 4c-4.97 0-9 4.03-9 9s4.02 9 9 9 9-4.03 9-9c0-2.12-.74-4.07-1.97-5.61zM12 20c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z</StreamGeometry>
      <StreamGeometry x:Key="IconChevron">M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z</StreamGeometry>
      <StreamGeometry x:Key="IconBack">M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z</StreamGeometry>
      <StreamGeometry x:Key="IconShield">M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBox.bare">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="19" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource BqText}" />
      <Setter Property="CaretBrush" Value="{DynamicResource BqAccent}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource BqSelected}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource BqText}" />
    </Style>
    <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.bare:pointerover, TextBox.bare:focus">
      <Setter Property="Foreground" Value="{DynamicResource BqText}" />
    </Style>
    <Style Selector="TextBox.bare /template/ TextBlock#PART_Watermark">
      <Setter Property="Foreground" Value="{DynamicResource BqMuted}" />
    </Style>

    <Style Selector="Border.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="{DynamicResource BqHover}" />
    </Style>
    <Style Selector="Border.row.selected">
      <Setter Property="Background" Value="{DynamicResource BqSelected}" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource BqMuted}" />
      <Setter Property="Margin" Value="20,10,0,4" />
    </Style>

    <Style Selector="Border.kbd">
      <Setter Property="Background" Value="{DynamicResource BqKbd}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="MinWidth" Value="18" />
    </Style>
    <Style Selector="Border.kbd > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource BqText}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource BqMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
    </Style>
    <Style Selector="TextBlock.hint.toast">
      <Setter Property="Foreground" Value="{DynamicResource BqAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Application.Styles>
</Application>
