<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>vaultbar</AssemblyName>
    <RootNamespace>Vaultbar</RootNamespace>
    <Version>0.2.0</Version>
    <Product>Vaultbar</Product>
    <Description>Quick search bar for Bitwarden</Description>
    <Authors>Thomas Hofman</Authors>
    <Copyright>Copyright (c) 2026 Thomas Hofman</Copyright>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\branding\app-icon\app.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
    <PackageReference Include="System.Formats.Cbor" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\branding\app-icon\app.ico" Link="Assets\app.ico" />
    <AvaloniaResource Include="..\..\branding\app-icon\png\icon-256.png" Link="Assets\icon-256.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vaultbar.Tests" />
    <InternalsVisibleTo Include="Vaultbar.MacE2E" />
  </ItemGroup>

</Project>
